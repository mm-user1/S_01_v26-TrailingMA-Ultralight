{
  "id": "s03_reversal_v16_4_a_adaptive_ma_b2",
  "name": "S03 Reversal v16-4-A Adaptive MA B2",
  "version": "v16-4-a-b2",
  "engine": "v2",
  "description": "Adaptive MA reversal with Close Count and T Bands on generic V2 execution.",
  "author": "",
  "execution": {
